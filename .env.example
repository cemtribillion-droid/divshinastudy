# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
AI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Session & Auth Secret (auto-derived in local dev if omitted; set strong secret in production)
AUTH_SESSION_SECRET=""

# Optional Supabase Configuration (Production PostgreSQL + Auth + Storage)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional Server-Side Admin Credentials (set in Netlify/server environment for instant admin login)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_BOOTSTRAP_EMAILS=""

# Resend Automated Email Delivery (Server-side only — never prefix with VITE_)
RESEND_API_KEY=""
EMAIL_FROM="Divshinastudy <onboarding@resend.dev>"
